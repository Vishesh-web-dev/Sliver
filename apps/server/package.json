{
  "name": "@sliver/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sliver game server: Hono REST API + WebSocket hub. Runs on Neon Functions in production, Node locally.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/entry/node.ts",
    "start": "tsx src/entry/node.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "bots": "tsx scripts/bots.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@neon/functions": "^0.11.0",
    "@sliver/shared": "*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.15.6",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
