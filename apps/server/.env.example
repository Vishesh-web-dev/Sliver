# Copy to apps/server/.env and adjust. Never commit .env.

# Local: the docker-compose Postgres (npm run db:up).
# Production: Neon injects DATABASE_URL into the function automatically. For
# migrations/seed against Neon, use the *unpooled* (direct) connection string.
DATABASE_URL=postgresql://sliver:sliver@localhost:5434/sliver

# Used only by the automated tests (docker-compose creates it).
TEST_DATABASE_URL=postgresql://sliver:sliver@localhost:5434/sliver_test

# Local dev server port.
PORT=8787

# Comma-separated browser origins allowed to call the API (CORS).
# Production: your Vercel URL(s), e.g. https://sliver.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Optional tuning (defaults shown).
# MAX_PLAYERS_PER_ROOM=50
# DB_POOL_MAX=5
